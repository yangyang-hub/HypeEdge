# HypeEdge mainnet 环境变量骨架（占位符版）
# 用途：从 testnet 切换到 mainnet 时参考。复制为 .env 前，把每个 <...> 替换为真实值。
# 切勿将真实密钥写入 .env 并提交版本控制；生产推荐经 secret manager / EnvironmentFile(0600) 注入。
# 完整的部署说明见 docs/deployment.md 与 docs/mainnet_go_live.md。

# ── 运行环境 / Hyperliquid 网络 ───────────────────────────────
# mainnet → 自动加载 configs/mainnet.yaml + 官方 mainnet API/WS
HYPE_ENV=mainnet

# ⚠️ mainnet 交易硬禁用解除开关：这是唯一允许 mainnet 真实交易的开关
# （crates/app/src/runtime.rs:119-127，未设置时 mainnet 启动直接报错拒绝）。
# 按 docs/mainnet_go_live.md 逐项确认后再取消注释并置 1。
# HYPE_MAINNET_TRADING_ENABLED=1

# ── Hyperliquid 交易凭证（mainnet 必需，loader 会硬校验）────────
# Agent/API Wallet；主钱包私钥禁止进入交易进程
HYPE_EXCHANGE__ACCOUNT_ADDRESS=<mainnet 账户地址 0x...>
HYPE_EXCHANGE__AGENT_PRIVATE_KEY=<agent 私钥 0x...>

# 子账户名称（不使用留空）
HYPE_EXCHANGE__SUB_ACCOUNT=

# ── 日志 ──────────────────────────────────────────────────────
HYPE_LOG_LEVEL=INFO

# ── ClickHouse（行情时序数据）──────────────────────────────────
HYPE_CLICKHOUSE__HOST=<host>
HYPE_CLICKHOUSE__PORT=8123
HYPE_CLICKHOUSE__DATABASE=hypeedge_mainnet
HYPE_CLICKHOUSE__USERNAME=<user>
HYPE_CLICKHOUSE__PASSWORD=<pass>

# ── Postgres（事务事实源；mainnet 必需、独立库、TLS、强密码）───
# loader 拒绝弱密码且必须 ssl=require/verify-ca/verify-full；请勿复用 testnet 库
HYPE_POSTGRES__URL=postgresql://<user>:<强随机密码>@<host>:5432/<mainnet_db>?ssl=require

# ── 后端 API 监听 ─────────────────────────────────────────────
# mainnet 安全默认是 127.0.0.1（configs/mainnet.yaml）；若必须绑非回环，需置于 TLS 反代/受信私网后
# HYPE_API__HOST=127.0.0.1

# ── 后端 API 分级 Bearer Token（mainnet 必需至少一个，全 ≥32 随机字符）──
# 生成：openssl rand -base64 32   # 或任意 ≥32 字符随机串
# 只读：查看行情、持仓、系统状态
HYPE_API__VIEWER_TOKEN=<viewer token>
# 操作员：策略启停、参数调整
HYPE_API__OPERATOR_TOKEN=<operator token>
# 管理员：Kill Switch、高危操作（mainnet 强烈建议配置）
HYPE_API__ADMIN_TOKEN=<admin token>

# ── Next.js 仪表盘（仅服务端读取，禁止 NEXT_PUBLIC_ 前缀）──────
# 后端内网地址（同机代理用 127.0.0.1）
HYPEEDGE_BACKEND_URL=http://127.0.0.1:37001

# 若启用了 HYPE_API__*TOKEN，须在 web/.env.local 设 HYPEEDGE_DASHBOARD_AUTH=on
# 并为对应角色配置完整三元组（用户名/密码/API token），否则代理无法带 Bearer。
HYPEEDGE_DASHBOARD_VIEWER_USERNAME=<viewer user>
HYPEEDGE_DASHBOARD_VIEWER_PASSWORD=<viewer pass>
HYPEEDGE_VIEWER_API_TOKEN=<与 HYPE_API__VIEWER_TOKEN 一致>

HYPEEDGE_DASHBOARD_OPERATOR_USERNAME=<operator user>
HYPEEDGE_DASHBOARD_OPERATOR_PASSWORD=<operator pass>
HYPEEDGE_OPERATOR_API_TOKEN=<与 HYPE_API__OPERATOR_TOKEN 一致>

HYPEEDGE_DASHBOARD_ADMIN_USERNAME=<admin user>
HYPEEDGE_DASHBOARD_ADMIN_PASSWORD=<admin pass>
HYPEEDGE_ADMIN_API_TOKEN=<与 HYPE_API__ADMIN_TOKEN 一致>

# ── 前端公开行情 WebSocket（只读，指向后端）───────────────────
NEXT_PUBLIC_HYPEEDGE_MARKET_WS_URL=ws://127.0.0.1:37001
